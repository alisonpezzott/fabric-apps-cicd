# The service principal of dev, for deployments from your machine:
#   python scripts/deploy_app.py --environment dev
# Copy to .env (never committed). Only credentials here: workspaces and
# models are in environments/*.yml. The service principal of prod is not
# here: its secret lives only in the pipeline.
FAB_TENANT_ID=
FAB_CLIENT_ID=
FAB_CLIENT_SECRET=
